<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_form_inherit_real_estate" model="ir.ui.view">
        <field name="name">product.product.form.inherit.real.estate</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex">
                    <field name="is_real_estate"/>
                     <label for="is_real_estate" string="Is Real Estate"/>
                </span>
            </xpath>
        </field>
    </record>

    <record id="view_product_template_form_inherit_real_estate" model="ir.ui.view">
        <field name="name">product.template.form.inherit.real.estate</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex">
                    <field name="is_real_estate"/>
                    <label for="is_real_estate" string="Is Real Estate"/>
                </span>
            </xpath>
        </field>
    </record>
</odoo>
