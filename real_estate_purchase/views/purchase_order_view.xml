<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="purchase_order_form_inherit_real_estate" model="ir.ui.view">
        <field name="name">purchase.order.form.form.inherit.real.estate</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="real_estate_id" options="{'no_create': True, 'no_open': True}" readonly="1" force_save="1"/>
                <field name="seller_id" options="{'no_create': True, 'no_open': True}" readonly="1" force_save="1"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="before">
                <field name="create_date"/>
                <field name="shipping_date"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='date_approve']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='date_planned_div']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='reminder']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_real_estate" model="ir.ui.view">
        <field name="name">account.move.form.inherit.real.estate</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_vendor_bill_id']" position="after">
                <field name="purchase_order" options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" readonly="1" force_save="1"/>
            </xpath>
        </field>
    </record>
</odoo>