<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_real_estate_tree" model="ir.ui.view">
        <field name="name">real.estate.tree</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <tree string="Real Estate">
                <field name="name"/>
                <field name="buyer_id"/>
                <field name="seller_id"/>
                <field name="shipping_date"/>
                <field name="shipping_method_id"/>
                <field name="purchase_order_id"/>
            </tree>
        </field>
    </record>

    <record id="view_real_estate_form" model="ir.ui.view">
        <field name="name">real.estate.form</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <form string="Real Estate">
                <sheet>
                    <header>
                        <button name="action_confirm_po" type="object" string="Confirm PO" class="btn-primary" invisible="purchase_order_id"/>
                    </header>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="buyer_id"/>
                            <field name="seller_id"/>
                        </group>
                        <group>
                            <field name="shipping_date"/>
                            <field name="shipping_method_id"/>
                            <field name="purchase_order_id" readonly="1" force_save="1" invisible="not purchase_order_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Line Items">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="skn"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="amount" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_search_view_real_estate" model="ir.ui.view">
        <field name="name">real.estate.search</field>
        <field name="model">real.estate</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="buyer_id"/>
                <field name="seller_id"/>
                <field name="shipping_date"/>
                <field name="shipping_method_id"/>
                <field name="purchase_order_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_buyer_id" domain="[]" context="{'group_by': 'buyer_id'}"/>
                    <filter name="group_by_seller_id" domain="[]" context="{'group_by': 'seller_id'}"/>
                    <filter name="group_by_purchase_order_id" domain="[]" context="{'group_by': 'purchase_order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_real_estate" model="ir.actions.act_window">
        <field name="name">Real Estate</field>
        <field name="res_model">real.estate</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_search_view_real_estate"/>
    </record>
</odoo>
